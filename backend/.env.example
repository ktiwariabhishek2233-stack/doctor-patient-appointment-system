# Port (provided automatically by hosting providers like Render/Railway)
PORT=5000

# Cloud MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mediconnect?retryWrites=true&w=majority

# JWT secret key for signing authentication tokens
JWT_SECRET=mediconnect_super_secret_jwt_key_2026_secure

# Frontend origin (or * to allow any)
CLIENT_ORIGIN=*
