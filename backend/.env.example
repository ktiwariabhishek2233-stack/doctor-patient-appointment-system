# Server Port
PORT=5000

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (secret key used ONLY by the backend server, never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# JWT Secret Key for token signing
JWT_SECRET=mediconnect_super_secret_jwt_key_2026_secure

# Allowed Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:3000
